# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; never commit real credentials.

# --- Supabase ---------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
# The URL is safe to expose; the anon key is designed to be public (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only key used by trusted backend code to bypass RLS (e.g. admin operations,
# seed scripts). NEVER expose this to the browser and NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Site -------------------------------------------------------------------
# Used for OAuth redirect URLs and email verification links.
# Dev: http://localhost:3000
# Prod: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- TMDB -------------------------------------------------------------------
# v4 "API Read Access Token" from https://www.themoviedb.org/settings/api
# This is a JWT starting with "eyJhbGci...". Server-only — never prefix with NEXT_PUBLIC_.
TMDB_ACCESS_TOKEN=YOUR-TMDB-V4-READ-ACCESS-TOKEN

# --- Optional integrations --------------------------------------------------
# Every variable above is required: the server validates them at boot
# (src/lib/env.ts) and exits with a list of what's missing. The ones below
# are optional; leave them blank to disable the feature.

# Shared rate-limit store (Upstash Redis, REST API). Set both or neither.
# Unset → per-instance in-memory limits, fine for local dev but only advisory
# on Vercel, where each instance keeps its own counters.
# Found in: Upstash Console -> your database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated auth user UUIDs allowed into /admin (moderation).
# Found in: Supabase Dashboard -> Authentication -> Users
ADMIN_USER_IDS=

# Error monitoring. Server errors are POSTed here as JSON (Slack / Discord
# incoming webhooks or any log endpoint). Unset → reporting is a no-op.
ERROR_WEBHOOK_URL=
